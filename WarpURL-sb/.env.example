# -------------------------------------------------------------
# WarpURL Backend Environment Configuration Template
# Duplicate this file as '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to version control.
# -------------------------------------------------------------

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/url_shortener_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password
SPRING_JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT Security
# Ensure this is a secure, random 256-bit (at least 64 hex characters) key in production
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_length_here
JWT_EXPIRATION=86400000

# Client Application URL (Configures CORS policy)
FRONTEND_URL=http://localhost:5173
